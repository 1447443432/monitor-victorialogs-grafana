# Local image build configuration.
# Project-specific values for the generic Image Make workflow.
# Keep registry credentials and HAP secrets in GitHub Actions Secrets.

IMAGE_TAG=1.0.0
ARCHITECTURES=all
PUSH_OPERATION=auto
RELEASE_NAME=hap-monitor-victorialogs-grafana

BASE_IMAGE_AMD64=alpine:3.23
BASE_IMAGE_ARM64=alpine:3.23

TARGET_IMAGE_AMD64=registry.cn-hangzhou.aliyuncs.com/hap-mdy/hap-monitor-victorialogs-grafana-amd64:1.0.0
TARGET_IMAGE_ARM64=registry.cn-hangzhou.aliyuncs.com/hap-mdy/hap-monitor-victorialogs-grafana-arm64:1.0.0

ALIYUN_REGISTRY=registry.cn-hangzhou.aliyuncs.com
ALIYUN_IMAGE_AMD64=registry.cn-hangzhou.aliyuncs.com/hap-mdy/hap-monitor-victorialogs-grafana-amd64:1.0.0
ALIYUN_IMAGE_ARM64=registry.cn-hangzhou.aliyuncs.com/hap-mdy/hap-monitor-victorialogs-grafana-arm64:1.0.0

ENABLE_ALIYUN_PUSH=true
ENABLE_RELEASE=true
ENABLE_HAP_WEBHOOK=true

DOCKERFILE=Dockerfile
BUILD_CONTEXT=.
ALPINE_MIRROR=https://mirrors.aliyun.com/alpine
ALPINE_VERSION=3.23
